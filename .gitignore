# Temp artifacts from headless-Chrome verification (see CLAUDE.md > Testing).
# These are written into the project dir because Windows Chrome cannot read WSL /tmp.
.shot-*.png
.smoke-test.html
.diag.html
.e2e*.html
.frame.html

# Node artifacts (this project has no npm dependencies; guard against strays)
node_modules/
package-lock.json

# Playwright MCP session output (snapshots, traces, screenshots)
.playwright-mcp/

# Third-party skills installed via `npx skills add`. skills-lock.json pins each
# to a content hash, so `npx skills experimental_install` restores them exactly.
# Not vendored: 3.7MB of code from other people's repositories.
.agents/
.claude/skills/
